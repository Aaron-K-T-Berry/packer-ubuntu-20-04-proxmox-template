#cloud-config
autoinstall:
  version: 1
  locale: ${locale}
  keyboard:
    layout: us
  identity:
    hostname: ${hostname}
    username: ${ssh_username}
    password: "${ssh_password_hash}"
  network:
    version: 2
    ethernets:
      id0:
        match:
          name: "en*"
        dhcp4: true
        dhcp-identifier: mac
      id1:
        match:
          name: "eth*"
        dhcp4: true
        dhcp-identifier: mac
  ssh:
    install-server: true
    allow-pw: true
    disable_root: true
  packages:
    - qemu-guest-agent
    - sudo
  storage:
    layout:
      name: direct
    swap:
      size: 0
  late-commands:
    - curtin in-target --target=/target systemctl enable qemu-guest-agent.service ssh.service
  user-data:
    package_upgrade: false
    timezone: ${timezone}
    users:
      - name: ${ssh_username}
        passwd: "${ssh_password_hash}"
        groups: [adm, sudo]
        lock-passwd: false
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
    runcmd:
      - systemctl restart qemu-guest-agent || systemctl start qemu-guest-agent || true
      - systemctl restart ssh || systemctl start ssh || true
